# ==================================================================
# Copie este arquivo para ".env" e ajuste os valores.
# Para desenvolvimento LOCAL com Supabase CLI (`npx supabase start`),
# os valores abaixo já são os padrões que a CLI expõe localmente.
# Rode `npx supabase status` para confirmar/copiar os valores atuais.
# ==================================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Banco de dados (Postgres do Supabase, local ou cloud) ---
# Local (padrão do `supabase start`):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase (Auth + Storage) ---
# Local (padrão do `supabase start`):
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="copie-de: npx supabase status"
SUPABASE_SERVICE_ROLE_KEY="copie-de: npx supabase status"
# Não precisa de JWT secret: os tokens são verificados via JWKS
# (${SUPABASE_URL}/auth/v1/.well-known/jwks.json), buscado automaticamente.

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Pagamentos ---
# Segredo que o "webhook" do provedor de PIX precisa enviar no header
# x-webhook-secret. Troque por um valor forte antes de ir pra produção.
PIX_WEBHOOK_SECRET=troque-este-segredo-local

# Usado pelo endpoint /promotions/cron-trigger (disparo diário das
# promoções automáticas em ambientes serverless, ex.: Vercel Cron).
# Em deploys na Vercel, cadastre essa mesma env var lá — ela injeta
# automaticamente "Authorization: Bearer <valor>" nas chamadas de cron.
CRON_SECRET=troque-este-segredo-local-tambem
